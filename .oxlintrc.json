{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error"
  },
  "settings": {},
  "ignorePatterns": ["**/dist", "**/node_modules"]
}
